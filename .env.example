# Copy this file to .env and fill in the values for the provider(s) you use.
# .env is git-ignored, so your keys are never pushed to the repository.
#
# Naming convention (see helper/llm_factory.py):
#   <PROVIDER>_API_KEY=...
#   <PROVIDER>_MODEL=...
# Choose the provider with the MODEL_PROVIDER variable at the top of each script
# (10_LJ_Solving_Your_Business_Problems_Example.py, orchestration-service.py, helper/guides_generator.py).

# Groq (MODEL_PROVIDER = 'Groq')
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (MODEL_PROVIDER = 'OpenRouter')
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# NVIDIA (MODEL_PROVIDER = 'NVIDIA')
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
